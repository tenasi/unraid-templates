    <Variable>
      <Value></Value>
      <Name>CERTBOT_EMAIL</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value></Value>
      <Name>CERTBOT_DOMAINS</Name>
      <Mode/>
    </Variable>
